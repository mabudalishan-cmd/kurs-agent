# ============================================================
# HelloWorld Academy — environment dəyişənləri
# ============================================================
# Bu faylı .env.local adı ilə kopyalayın və dəyərləri doldurun:
#
#   cp .env.example .env.local
#
# .env.local heç vaxt git-ə göndərilmir.
# ============================================================

# ── Sayt ünvanı (SEO üçün) ──────────────────────────────────
# Canonical linklər, sitemap.xml və sosial paylaşım kartları mütləq
# (absolute) URL tələb edir. Produksiyada real domeni yazın.
# Verilməsə localhost istifadə olunur.
NEXT_PUBLIC_SITE_URL=https://helloworld.az

# ── Supabase (MƏCBURİ) ──────────────────────────────────────
# Supabase Dashboard → Project Settings → API

# Layihənin URL-i. Brauzerə göndərilir.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anon key. Brauzerə göndərilir — RLS siyasətləri ilə qorunur.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. RLS-i tamamilə bypass edir.
# YALNIZ serverdə istifadə olunur — heç vaxt NEXT_PUBLIC_ prefiksi ilə yazmayın.
SUPABASE_SERVICE_ROLE_KEY=

# ── Gemini AI chat (istəyə bağlı) ───────────────────────────
# AI köməkçi widget-i üçün. Açar olmadan /api/chat 500 qaytarır.
# Açarı buradan alın: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model adı. Google model adlarını vaxtaşırı yeniləyir — cavab
# "model not found" xətası verərsə buranı dəyişin.
# Boş qalarsa gemini-2.0-flash istifadə olunur.
GEMINI_MODEL=

# ── Resend e-poçt göndərmə (istəyə bağlı) ───────────────────
# Email kampaniyalarının real göndərilməsi üçün.
# Açar olmadan /api/campaigns/send 503 qaytarır.
# Açarı buradan alın: https://resend.com/api-keys
RESEND_API_KEY=

# Göndərən ünvan. Domen Resend-də təsdiqlənməlidir.
# Nümunə: HelloWorld Academy <info@helloworld.az>
EMAIL_FROM=
